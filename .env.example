# 複製成 .env 後修改（或直接用 export 設環境變數）

# 本機 Ollama 的 OpenAI 相容端點；若講師有架共用伺服器，改成該網址 + /v1
OLLAMA_API_BASE=http://localhost:11434/v1

# Ollama 不驗證 key，但 LiteLLM 需要有值，隨便填即可
OLLAMA_API_KEY=ollama

# 要用的模型：請挑「支援 function / tool calling」的模型
# 課堂預設：gemma4:e4b（先 `ollama pull gemma4:e4b` 再啟動）
# 備用（若 gemma4:e4b 呼叫工具不穩定）：qwen2.5:7b 或 llama3.1:8b
OLLAMA_MODEL=gemma4:e4b
